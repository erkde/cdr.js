{
  "name": "cdr.js",
  "version": "0.1.0",
  "description": "Query organisations exposing data under Australia's Consumer Data Right.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cdr": "./bin/cdr.js"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "tsc --project tsconfig.json --noEmit && node --check bin/cdr.js",
    "pretest": "npm run build",
    "test": "node --test",
    "prepare": "npm run build"
  },
  "keywords": [
    "australia",
    "cdr",
    "consumer-data-right",
    "open-banking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erkde/cdr.js.git"
  },
  "bugs": {
    "url": "https://github.com/erkde/cdr.js/issues"
  },
  "homepage": "https://github.com/erkde/cdr.js#readme",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
